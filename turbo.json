{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "env": [
        "SIM_CHECK_EACH",
        "SIM_SEEDS",
        "TABS_COUNT",
        "TABS_SEEDS",
        "WALK_SEEDS",
        "WALK_STEPS"
      ]
    }
  }
}
