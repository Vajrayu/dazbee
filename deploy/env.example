# The production .env, beside deploy/ (/opt/dazbee/.env on the server), which only root and the
# deploy user read. Every value stays empty here; the real ones are set on the server only.

# Postgres's password, which the API and sync server connect with; letters and digits only.
POSTGRES_PASSWORD=
# The key the API signs sync tokens with and the sync server checks them with; at least 32 characters.
SYNC_TOKEN_SECRET=
# The key the API signs session tokens with; at least 32 characters.
SESSION_SECRET=
# WorkOS Production's API key.
WORKOS_API_KEY=
# WorkOS Production's client ID.
WORKOS_CLIENT_ID=
# Where WorkOS sends a person back after sign-in: the web app's /callback.
WORKOS_REDIRECT_URI=
# The S3 address of the files bucket.
STORAGE_ENDPOINT=
# The files bucket's name.
STORAGE_BUCKET=
# The access key ID of the key limited to the files bucket.
STORAGE_ACCESS_KEY_ID=
# The secret of that key.
STORAGE_SECRET_ACCESS_KEY=
# The API's early-access list: comma-separated emails that may sign up; empty lets anyone in.
ALLOWED_EMAILS=
# The API's early-access admins: comma-separated emails that use the admin page and are always let in.
ADMIN_EMAILS=
# The secret of the Cloudflare Turnstile widget on Request access, which the API checks tokens with.
TURNSTILE_SECRET_KEY=
# The web app's address people write to, which the early-access notice on /login names.
SUPPORT_EMAIL=
# The web app's host for the early-access admin page; pilot.dazbee.com when empty.
PILOT_HOST=
# The site key of the Cloudflare Turnstile widget on Request access; empty leaves the form without it.
TURNSTILE_SITE_KEY=
