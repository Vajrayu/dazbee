# Caddy in front of the production stack: app.dazbee.com to the live colour of the web app,
# sync.dazbee.com to the sync server, and http://caddy:8080, which only the containers reach, to the
# live colour of the API. Which colour is live comes from live/upstreams.caddy, which the deploy
# script rewrites before it reloads Caddy. Both public sites use Cloudflare's origin certificate,
# from the certs/ folder beside compose's .env, as origin.pem and origin.key.
{
	# Cloudflare's certificate is the only one Caddy serves, so it never asks a CA for one.
	auto_https disable_certs
	servers {
		protocols h1 h2
	}
}

import /etc/caddy/live/upstreams.caddy

app.dazbee.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy {
		import web_upstream
	}
}

sync.dazbee.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy sync:1234 {
		# A reload, as at each swap of the web app or API, keeps open designs' sockets for this long.
		# Every deploy restarts the sync server, which closes them sooner.
		stream_close_delay 24h
	}
}

http://caddy:8080 {
	reverse_proxy {
		import api_upstream
	}
}
