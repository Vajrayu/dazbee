# The live colour of the web app and of the API, which the Caddyfile imports from live/upstreams.caddy.
# This copy, with blue live, is the one a new server starts with; the deploy script rewrites the
# one in live/ at each swap.
(web_upstream) {
	to web-blue:3000
}

(api_upstream) {
	to api-blue:8787
}
